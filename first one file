
#include <stdio.h>

int main() {
    double num1, num2, result;
    char operator;

    printf("================================\n");
    printf("       SIMPLE CALCULATOR\n");
    printf("================================\n");

    printf("Enter first number: ");
    scanf("%lf", &num1);

    printf("Enter an operator (+, -, *, /): ");
    scanf(" %c", &operator);

    printf("Enter second number: ");
    scanf("%lf", &num2);

    switch (operator) {
        case '+':
            result = num1 + num2;
            printf("\nResult = %.2lf\n", result);
            break;

        case '-':
            result = num1 - num2;
            printf("\nResult = %.2lf\n", result);
            break;

        case '*':
            result = num1 * num2;
            printf("\nResult = %.2lf\n", result);
            break;

        case '/':
            if (num2 != 0) {
                result = num1 / num2;
                printf("\nResult = %.2lf\n", result);
            } else {
                printf("\nError! Division by zero is not allowed.\n");
            }
            break;

        default:
            printf("\nInvalid operator!\n");
    }

    printf("================================\n");
    printf("       THANK YOU!\n");
    printf("================================\n");

    return 0;
}
